---
import Footer from "../components/Footer.astro";
import GraphViewer from "../components/GraphViewer";
import Nav from "../components/Nav.astro";
import Sidebar from "../components/docs/Sidebar.astro";
import Base from "./Base.astro";
import "../styles/docs.css";
import "../styles/graph.css";

interface TocHeading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description?: string;
	currentSlug?: string;
	currentSection?: string;
	showSidebar?: boolean;
	wide?: boolean;
	toc?: TocHeading[];
	previousDoc?: {
		title: string;
		url: string;
	};
	nextDoc?: {
		title: string;
		url: string;
	};
}

const {
	title,
	description,
	currentSlug,
	currentSection,
	showSidebar = true,
	wide = false,
	toc,
	previousDoc,
	nextDoc,
} = Astro.props;

const tocHeadings = toc?.filter((h) => h.depth === 2 || h.depth === 3) ?? [];
const hasToc = tocHeadings.length > 2;

interface TocGroup {
	slug: string;
	text: string;
	subs: { slug: string; text: string }[];
}

const tocGroups: TocGroup[] = [];
let currentGroup: TocGroup | null = null;
for (const h of tocHeadings) {
	if (h.depth === 2) {
		currentGroup = { slug: h.slug, text: h.text, subs: [] };
		tocGroups.push(currentGroup);
	} else if (h.depth === 3 && currentGroup) {
		currentGroup.subs.push({ slug: h.slug, text: h.text });
	}
}
---

<Base title={`${title} — Signet Docs`} description={description}>
  <Nav variant="bar" />

  <div class="docs-shell">
    <div class:list={["docs-content-grid", { "docs-content-grid--no-sidebar": !showSidebar }]}>
      <!-- Left rail: docs nav -->
      {showSidebar ? (
        <aside class="docs-rail">
          <div class="docs-rail-sticky">
            <Sidebar currentSlug={currentSlug} />
          </div>
        </aside>
      ) : null}

      <!-- Main content -->
      <main class:list={["docs-main", { "docs-main--wide": wide }]}>
        <header class="docs-article-header">
          <p class="docs-kicker">
            <a href="/docs">Docs</a>
            {currentSection ? <span>/ {currentSection}</span> : null}
          </p>
          <h1>{title}</h1>
          {description ? <p class="docs-description">{description}</p> : null}
        </header>

        {hasToc ? (
          <nav class="docs-toc-inline" aria-label="Table of contents">
            <p class="docs-rail-label">On this page</p>
            <ul class="docs-rail-toc-list">
              {tocGroups.map((g) => (
                <li class="docs-toc-group">
                  <a href={`#${g.slug}`} data-toc-link data-toc-h2>{g.text}</a>
                  {g.subs.length > 0 ? (
                    <ul class="docs-toc-subs">
                      {g.subs.map((s) => (
                        <li>
                          <a href={`#${s.slug}`} data-toc-link data-toc-sub>{s.text}</a>
                        </li>
                      ))}
                    </ul>
                  ) : null}
                </li>
              ))}
            </ul>
          </nav>
        ) : null}

        <article class="prose">
          <slot />
        </article>

        {(previousDoc || nextDoc) ? (
          <nav class="docs-pager" aria-label="Page navigation">
            {previousDoc ? (
              <a class="docs-pager-link" href={previousDoc.url} rel="prev">
                <span class="docs-pager-label">Previous</span>
                <span class="docs-pager-title">{previousDoc.title}</span>
              </a>
            ) : <span class="docs-pager-spacer"></span>}

            {nextDoc ? (
              <a class="docs-pager-link" href={nextDoc.url} rel="next">
                <span class="docs-pager-label">Next</span>
                <span class="docs-pager-title">{nextDoc.title}</span>
              </a>
            ) : <span class="docs-pager-spacer"></span>}
          </nav>
        ) : null}

        <Footer />
      </main>

      <!-- Right rail: graph widget + TOC -->
      {hasToc ? (
        <aside class="docs-toc-rail">
          <div class="docs-toc-rail-sticky">
            {currentSlug ? (
              <div class="docs-graph-widget">
                <GraphViewer client:idle currentSlug={currentSlug} collection="docs" mode="local" />
              </div>
            ) : null}

            <nav aria-label="Table of contents">
              <p class="docs-rail-label">On this page</p>
              <ul class="docs-rail-toc-list">
                {tocGroups.map((g) => (
                  <li class="docs-toc-group">
                    <a href={`#${g.slug}`} data-toc-link data-toc-h2>{g.text}</a>
                    {g.subs.length > 0 ? (
                      <ul class="docs-toc-subs">
                        {g.subs.map((s) => (
                          <li>
                            <a href={`#${s.slug}`} data-toc-link data-toc-sub>{s.text}</a>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      ) : null}
    </div>
  </div>

  <script>
    function initCodeToolbars() {
      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
        if (pre.querySelector('.code-toolbar')) return;

        const code = pre.querySelector('code');
        const langMatch = code?.className.match(/language-([a-zA-Z0-9_+-]+)/);
        const lang = langMatch ? langMatch[1] : 'shell';

        const toolbar = document.createElement('div');
        toolbar.className = 'code-toolbar';

        const langLabel = document.createElement('span');
        langLabel.className = 'code-toolbar-lang';
        langLabel.textContent = lang;

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'code-copy';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', 'Copy code block');
        copy.addEventListener('click', async () => {
          const text = code?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            copy.textContent = 'Copied';
            copy.classList.add('is-copied');
            setTimeout(() => {
              copy.textContent = 'Copy';
              copy.classList.remove('is-copied');
            }, 1500);
          } catch {
            copy.textContent = 'Copy';
          }
        });

        toolbar.append(langLabel, copy);
        pre.prepend(toolbar);
      });
    }

    function initDocsScrollSpy() {
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
      if (!links.length) return;

      const headingIds = Array.from(links).map((a) => a.getAttribute('href')?.slice(1)).filter(Boolean) as string[];
      const headings = headingIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

      if (!headings.length) return;

      let active: HTMLAnchorElement | null = null;

      function update() {
        const scrollY = window.scrollY + 100;
        let current: string | null = null;

        for (let i = headings.length - 1; i >= 0; i--) {
          if (headings[i].offsetTop <= scrollY) {
            current = headings[i].id;
            break;
          }
        }

        if (!current && headings.length) {
          current = headings[0].id;
        }

        if (active) active.removeAttribute('data-active');
        if (current) {
          const next = document.querySelector<HTMLAnchorElement>(`[data-toc-link][href="#${current}"]`);
          if (next) {
            next.setAttribute('data-active', '');
            active = next;
          }
        }

        // Expand only the group containing the active heading (H2-only default).
        document.querySelectorAll<HTMLElement>('.docs-toc-group').forEach((group) => {
          const hasActive =
            group.querySelector<HTMLAnchorElement>(`[data-toc-link][href="#${current}"]`) !== null;
          group.classList.toggle('is-expanded', hasActive);
        });
      }

      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => { update(); ticking = false; });
          ticking = true;
        }
      }, { passive: true });

      update();
    }

    initCodeToolbars();
    initDocsScrollSpy();
    document.addEventListener('astro:after-swap', () => {
      initCodeToolbars();
      initDocsScrollSpy();
    });
  </script>
</Base>
