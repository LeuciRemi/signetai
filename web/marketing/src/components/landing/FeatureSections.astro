---
const features = [
	{
		index: "02 / 07",
		label: "DREAMING",
		title: "Memory that maintains itself",
		desc: "When sessions end or go idle, the dreaming loop runs: it distills transcripts into structured memory, extracts entities and claims, supersedes stale context, and keeps the graph current — all without manual saves.",
		points: [
			"Auto-distills idle session transcripts into structured memory",
			"Supersedes stale claims with provenance instead of stacking duplicates",
			"Runs entirely on your own model and embedding stack",
		],
		visual: "dream",
		windowTitle: "signet — dreaming",
		split: "text",
	},
	{
		index: "03 / 07",
		label: "SELF-HOSTED",
		title: "One command. Your machine.",
		desc: "A single static binary installs the full stack — SQLite workspace, daemon, dashboard — with no cloud account and no vendor lock-in. Your memory is files you can inspect, back up, and move.",
		points: [
			"One-line install, zero cloud dependencies",
			"SQLite workspace you can read, back up, and port",
			"Local embeddings and recall stay on-device",
		],
		visual: "install",
		windowTitle: "signet — install",
		split: "visual",
	},
	{
		index: "04 / 07",
		label: "HARNESSES",
		title: "Installs under your harness, not instead of it",
		desc: "Hooks, MCP, plugins, and first-party connectors wire Signet into every major agent shell. The same memory and secrets follow your agent from one tool to the next.",
		points: [
			"Claude Code, OpenCode, OpenClaw, Codex, Hermes Agent, Pi, Oh My Pi, Gemini CLI",
			"Hooks + MCP + runtime plugins + AGENTS.md / CLAUDE.md sync",
			"Memory survives tool churn — switch harnesses, keep context",
		],
		visual: "harness",
		windowTitle: "signet — harnesses",
		split: "text",
	},
	{
		index: "05 / 07",
		label: "SOURCES",
		title: "Recall with receipts",
		desc: "Transcripts, notes, repos, and documents ingest as ground truth. Every memory points back to the artifact it came from, so recall is inspectable and repairable — never a black box.",
		points: [
			"Ingest transcripts, docs, and repos as durable sources",
			"Every memory links back to the evidence that justifies it",
			"Purge by source — derived context goes, evidence stays",
		],
		visual: "sources",
		windowTitle: "signet — sources",
		split: "visual",
	},
];

const installLines = [
	[
		{ cls: "p", text: "$" },
		{ cls: "c", text: " curl " },
		{ cls: "f", text: "-fsSL " },
		{ cls: "c", text: "https://signetai.sh/install.sh | bash" },
	],
	{ out: "✓ binary linked · workspace initialized · daemon started" },
	[
		{ cls: "p", text: "$" },
		{ cls: "c", text: " signet status" },
	],
	{ out: "● daemon running · memory pipeline healthy" },
];

const setupLines = [
	[
		{ cls: "p", text: "$" },
		{ cls: "c", text: " signet setup" },
	],
	{ out: "agent name [atlas]: signet setup --identity-mode off" },
	{ out: "✓ harness detected: claude-code · hooks installed" },
	{ out: "✓ embedding provider: built-in (on-device)" },
];

const workLines = [
	[
		{ cls: "p", text: "$" },
		{ cls: "c", text: " signet remember " },
		{ cls: "q", text: '"prefers bun over npm"' },
	],
	{ out: "✓ memory saved · source-backed" },
	[
		{ cls: "p", text: "$" },
		{ cls: "c", text: " signet recall " },
		{ cls: "q", text: '"package manager preference"' },
	],
	{ out: "→ prefers bun over npm (source: transcript 2026-08-07)" },
];
---

<section class="feature-sections">
  {features.map((f, i) => (
    <div class="feat-row">
      <div class="container feat-container">
        <div class="section-header reveal">
          <div class="crosshair"></div>
          <span class="section-label">{f.label}</span>
          <span class="section-index">{f.index}</span>
        </div>

        <div class:list={["feat-grid", { "feat-grid--visual": f.split === "visual" }]}>
          <div class="feat-copy reveal">
            <h2 class="feat-title">{f.title}</h2>
            <p class="feat-desc">{f.desc}</p>
            <ul class="feat-points">
              {f.points.map((p) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="6.5" stroke="#38bdf8" stroke-opacity="0.35" stroke-width="1"/>
                    <path d="M4 7.2l2 2 4-4.4" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="feat-window reveal">
            <div class="feat-window-bar">
              <span class="feat-window-dots">
                <span class="feat-window-dot"></span>
                <span class="feat-window-dot"></span>
                <span class="feat-window-dot"></span>
              </span>
              <span class="feat-window-title">{f.windowTitle}</span>
            </div>

            <div class="feat-window-body">
              {f.visual === 'dream' && (
                <svg viewBox="0 0 640 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g>
                    <rect x="20" y="34" width="150" height="52" rx="10" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <text x="38" y="66" fill="#ffffff" font-size="14" font-family="monospace">Raw Session</text>
                    <path d="M174 60h44" stroke="#60a5fa" stroke-width="2"/>
                    <path d="M210 52l10 8-10 8" fill="none" stroke="#60a5fa" stroke-width="2"/>
                    <rect x="218" y="34" width="150" height="52" rx="10" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <text x="236" y="66" fill="#ffffff" font-size="14" font-family="monospace">Distillation</text>
                    <path d="M372 60h42" stroke="#60a5fa" stroke-width="2"/>
                    <path d="M406 52l10 8-10 8" fill="none" stroke="#60a5fa" stroke-width="2"/>
                    <rect x="414" y="34" width="150" height="52" rx="10" fill="rgba(59,130,246,0.1)" stroke="#3b82f6" stroke-width="1"/>
                    <text x="432" y="66" fill="#93c5fd" font-size="14" font-family="monospace">Structured Memory</text>
                  </g>
                  <g font-size="12" font-family="monospace">
                    <rect x="218" y="112" width="346" height="24" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
                    <text x="232" y="128" fill="#38bdf8">extract → supersede → propose (evidence-backed)</text>
                  </g>
                  <g stroke="#38bdf8" stroke-width="2.5" fill="none" opacity="0.9">
                    <path d="M40 176q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0t18 0q9-9 18 0" />
                  </g>
                  <circle cx="40" cy="176" r="4" fill="#38bdf8"/>
                  <circle cx="40" cy="176" r="8" stroke="#38bdf8" stroke-opacity="0.3" stroke-width="1"/>
                  <text x="560" y="190" fill="#94a3b8" font-size="12" font-family="monospace">idle consolidation pulse</text>
                </svg>
              )}
              {f.visual === 'install' && (
                <div class="feat-term">
                  {installLines.map((line) =>
                    Array.isArray(line) ? (
                      <div class="feat-term-cmd">
                        {line.map((part) => <span class={`feat-term-${part.cls}`}>{part.text}</span>)}
                      </div>
                    ) : (
                      <div class="feat-term-out">{line.out}</div>
                    )
                  )}
                </div>
              )}
              {f.visual === 'harness' && (
                <div class="feat-harness-grid">
                  <span class="feat-harness-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="m3.127 10.604 3.135-1.76.053-.153-.053-.085H6.11l-.525-.032-1.791-.048-1.554-.065-1.505-.08-.38-.081L0 7.832l.036-.234.32-.214.455.04 1.009.069 1.513.105 1.097.064 1.626.17h.259l.036-.105-.089-.065-.068-.064-1.566-1.062-1.695-1.121-.887-.646-.48-.327-.243-.306-.104-.67.435-.48.585.04.15.04.593.456 1.267.981 1.654 1.218.242.202.097-.068.012-.049-.109-.181-.9-1.626-.96-1.655-.428-.686-.113-.411a2 2 0 0 1-.068-.484l.496-.674L4.446 0l.662.089.279.242.411.94.666 1.48 1.033 2.014.302.597.162.553.06.17h.105v-.097l.085-1.134.157-1.392.154-1.792.052-.504.25-.605.497-.327.387.186.319.456-.045.294-.19 1.23-.37 1.93-.243 1.29h.142l.161-.16.654-.868 1.097-1.372.484-.545.565-.601.363-.287h.686l.505.751-.226.775-.707.895-.585.759-.839 1.13-.524.904.048.072.125-.012 1.897-.403 1.024-.186 1.223-.21.553.258.06.263-.218.536-1.307.323-1.533.307-2.284.54-.028.02.032.04 1.029.098.44.024h1.077l2.005.15.525.346.315.424-.053.323-.807.411-3.631-.863-.872-.218h-.12v.073l.726.71 1.331 1.202 1.667 1.55.084.383-.214.302-.226-.032-1.464-1.101-.565-.497-1.28-1.077h-.084v.113l.295.432 1.557 2.34.08.718-.112.234-.404.141-.444-.08-.911-1.28-.94-1.44-.759-1.291-.093.053-.448 4.821-.21.246-.484.186-.403-.307-.214-.496.214-.98.258-1.28.21-1.016.19-1.263.112-.42-.008-.028-.092.012-.953 1.307-1.448 1.957-1.146 1.227-.274.109-.477-.247.045-.44.266-.39 1.586-2.018.956-1.25.617-.723-.004-.105h-.036l-4.212 2.736-.75.096-.324-.302.04-.496.154-.162 1.267-.871z"/></svg>
                    <span>Claude Code</span>
                  </span>
                  <span class="feat-harness-item"><img src="/harness-logos/opencode.svg" alt="" width="18" height="18" loading="lazy" /><span>OpenCode</span></span>
                  <span class="feat-harness-item"><img src="/harness-logos/openclaw.svg" alt="" width="18" height="18" loading="lazy" /><span>OpenClaw</span></span>
                  <span class="feat-harness-item">
                    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/></svg>
                    <span>Codex</span>
                  </span>
                  <span class="feat-harness-item"><img src="/harness-logos/hermes-agent-32.png" alt="" width="18" height="18" loading="lazy" /><span>Hermes Agent</span></span>
                  <span class="feat-harness-item">
                    <svg viewBox="0 0 800 800" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="transform: scale(1.15);"><path fill-rule="evenodd" d="M165.29 165.29H517.36V400H400v117.36H282.65v117.36H165.29Zm117.36 117.36V400H400V282.65Z"/><path d="M517.36 400h117.36v234.72H517.36Z"/></svg>
                    <span>Pi</span>
                  </span>
                  <span class="feat-harness-item">
                    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm3.5 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM12 19c-3.314 0-6-2.015-6-4.5h1.5c0 1.657 2.015 3 4.5 3s4.5-1.343 4.5-3H18c0 2.485-2.686 4.5-6 4.5z"/></svg>
                    <span>Oh My Pi</span>
                  </span>
                </div>
              )}
              {f.visual === 'sources' && (
                <svg viewBox="0 0 640 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g>
                    <rect x="20" y="40" width="130" height="56" rx="10" fill="rgba(59,130,246,0.1)" stroke="#3b82f6" stroke-width="1"/>
                    <text x="48" y="74" fill="#93c5fd" font-size="14" font-family="monospace">Recall</text>
                    <path d="M154 68h52" stroke="#60a5fa" stroke-width="2"/>
                    <path d="M198 60l10 8-10 8" fill="none" stroke="#60a5fa" stroke-width="2"/>
                    <rect x="206" y="40" width="140" height="56" rx="10" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <text x="236" y="74" fill="#ffffff" font-size="14" font-family="monospace">Memory</text>
                    <path d="M350 68h52" stroke="#60a5fa" stroke-width="2"/>
                    <path d="M394 60l10 8-10 8" fill="none" stroke="#60a5fa" stroke-width="2"/>
                    <rect x="402" y="40" width="150" height="56" rx="10" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <text x="422" y="74" fill="#ffffff" font-size="14" font-family="monospace">Transcript</text>
                    <path d="M556 68h50" stroke="#60a5fa" stroke-width="2"/>
                    <path d="M598 60l10 8-10 8" fill="none" stroke="#60a5fa" stroke-width="2"/>
                    <rect x="606" y="40" width="24" height="56" rx="10" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
                    <text x="611" y="74" fill="#ffffff" font-size="11" font-family="monospace">Src</text>
                  </g>
                  <g font-size="12" font-family="monospace">
                    <rect x="138" y="14" width="72" height="18" rx="4" fill="#0d0d12"/>
                    <text x="146" y="27" fill="#38bdf8">provenance</text>
                    <rect x="340" y="14" width="86" height="18" rx="4" fill="#0d0d12"/>
                    <text x="348" y="27" fill="#94a3b8">raw evidence</text>
                  </g>
                  <g fill="#3b82f6">
                    <circle cx="85" cy="130" r="3"/>
                    <circle cx="276" cy="130" r="3"/>
                    <circle cx="477" cy="130" r="3"/>
                    <circle cx="618" cy="130" r="3"/>
                  </g>
                  <g stroke="rgba(255,255,255,0.16)" stroke-width="1">
                    <line x1="85" y1="130" x2="276" y2="130" />
                    <line x1="276" y1="130" x2="477" y2="130" />
                    <line x1="477" y1="130" x2="618" y2="130" />
                  </g>
                  <text x="20" y="180" fill="#94a3b8" font-size="13" font-family="monospace">every memory carries a path back to the artifact that justifies it</text>
                </svg>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}
</section>

<style>
  .feature-sections {
    border-top: 1px solid var(--color-border);
  }

  .feat-row {
    padding-block: clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--color-border);
  }

  .feat-row:last-child {
    border-bottom: none;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .feat-grid--visual {
    grid-template-columns: 1fr 1.15fr;
  }

  .feat-title {
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #ffffff;
    margin-bottom: var(--space-md);
    line-height: 1.15;
  }

  .feat-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 520px;
    margin-bottom: var(--space-lg);
  }

  .feat-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feat-points li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  .feat-points svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Unified window framing for every preview */
  .feat-window {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    background: #0a0a0e;
    overflow: hidden;
    height: 300px;
    display: flex;
    flex-direction: column;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  .feat-window-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
  }

  .feat-window-dots {
    display: inline-flex;
    gap: 6px;
  }

  .feat-window-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .feat-window-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .feat-window-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 24px;
    overflow: hidden;
  }

  .feat-window-body svg {
    width: 100%;
    height: 100%;
  }

  .feat-term {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .feat-term-cmd {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: #e2e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feat-term-p { color: #64748b; font-weight: 600; }
  .feat-term-c { color: #e2e8f0; }
  .feat-term-f { color: #38bdf8; }
  .feat-term-q { color: #a5b4fc; }

  .feat-term-out {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #4ade80;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feat-harness-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
  }

  .feat-harness-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
    padding: 14px 16px;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .feat-harness-item:hover {
    color: #ffffff;
    border-color: rgba(77, 124, 254, 0.4);
    background: rgba(77, 124, 254, 0.06);
  }

  .feat-harness-item svg,
  .feat-harness-item img {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .feat-grid,
    .feat-grid--visual {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .feat-window {
      height: 260px;
    }
  }
</style>
